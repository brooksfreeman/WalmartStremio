[Unit]
Description=Owner TV Stremio lab
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 "/path/to/WalmartStremio/scripts/service_entry.py" lab --bind 192.0.2.24
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=default.target
